{
    "cli": true,
    "target": "directory",
    "adapterName": "skyorama",
    "title": "Skyorama",
    "description": "The sky over your location: aircraft nearby, visible passes of the ISS and Tiangong, darkness, the moon and planets, tonight's sky, whether the aurora can be seen from home, and lightning nearby.",
    "keywords": [
        "sky",
        "aircraft",
        "ads-b",
        "satellites",
        "iss",
        "astronomy",
        "aurora",
        "lightning"
    ],
    "contributors": [],
    "expert": "yes",
    "features": [
        "adapter"
    ],
    "adminFeatures": [],
    "type": "misc-data",
    "startMode": "daemon",
    "connectionType": "cloud",
    "dataSource": "poll",
    "connectionIndicator": "yes",
    "language": "TypeScript",
    "nodeVersion": "22",
    "adminUi": "json",
    "tools": [
        "ESLint",
        "type checking",
        "Prettier"
    ],
