    "i18n": "JSON",
    "releaseScript": "yes",
    "devServer": "no",
    "indentation": "Space (4)",
    "quotes": "single",
    "gitRemoteProtocol": "HTTPS",
    "gitCommit": "no",
    "defaultBranch": "main",
    "authorName": "Alan Paris",
