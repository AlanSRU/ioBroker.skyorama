{
    "i18n": true,
    "type": "tabs",
    "items": {
        "locationTab": {
            "type": "panel",
            "label": "Location",
            "items": {
                "useSystemLocation": {
                    "type": "checkbox",
                    "label": "Use the latitude and longitude from the system settings",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "latitude": {
                    "type": "number",
                    "label": "Latitude",
                    "help": "Degrees, north positive",
                    "min": -90,
                    "max": 90,
                    "step": 0.0001,
                    "hidden": "data.useSystemLocation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "longitude": {
                    "type": "number",
                    "label": "Longitude",
                    "help": "Degrees, east positive",
                    "min": -180,
                    "max": 180,
                    "step": 0.0001,
                    "hidden": "data.useSystemLocation",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "satellitesTab": {
            "type": "panel",
            "label": "Satellites",
            "items": {
                "satellitesEnabled": {
                    "type": "checkbox",
                    "label": "Track satellites",
                    "help": "Orbits from CelesTrak, at most twice a day; visible passes of the satellites you choose",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "satelliteGroups": {
                    "type": "text",
                    "label": "Additional CelesTrak groups",
                    "help": "Comma-separated CelesTrak group names for the orbit set given to front-ends (default: visual, the brightest satellites). The space stations are always included.",
                    "disabled": "!data.satellitesEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "trackedSatellites": {
                    "type": "selectSendTo",
                    "command": "satelliteOptions",
                    "multiple": true,
                    "noTranslation": true,
                    "label": "Satellites to track (passes and alerts)",
                    "help": "Up to 20, chosen from the current orbit set (the adapter must be running to list them). ISS and Tiangong by default.",
                    "disabled": "!data.satellitesEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "passAlertLeadMin": {
                    "type": "number",
                    "label": "Alert this many minutes before a visible flyover",
                    "help": "The alert is written this long before the satellite comes into view",
                    "min": 1,
                    "max": 120,
                    "disabled": "!data.satellitesEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "passAlertMinEl": {
                    "type": "number",
                    "label": "Minimum flyover height for an alert (degrees above the horizon)",
                    "help": "No alert for flyovers that stay lower than this",
                    "min": 0,
                    "max": 90,
                    "disabled": "!data.satellitesEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "astronomyTab": {
            "type": "panel",
            "label": "Astronomy",
            "items": {
                "astronomyEnabled": {
                    "type": "checkbox",
                    "label": "Sun, moon, planets and tonight's sky",
                    "help": "Calculated locally, no internet access",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "aircraftTab": {
            "type": "panel",
            "label": "Aircraft",
            "items": {
                "aircraftEnabled": {
                    "type": "checkbox",
                    "label": "Aircraft (ADS-B)",
                    "help": "Polled only while a front-end asks for aircraft, or with background polling",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "receiverUrl": {
                    "type": "text",
                    "label": "Local receiver URL (optional)",
                    "help": "aircraft.json of your own dump1090, readsb or tar1090 receiver, e.g. http://192.168.1.20/tar1090/data/aircraft.json. Used instead of adsb.lol for aircraft around you.",
                    "disabled": "!data.aircraftEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "xl": 6
                },
                "backgroundEnabled": {
                    "type": "checkbox",
                    "label": "Background polling",
                    "help": "Keeps the aircraft states up to date for scripts and dashboards",
                    "disabled": "!data.aircraftEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "backgroundRadiusKm": {
                    "type": "number",
                    "label": "Background radius (km)",
                    "help": "Aircraft within this distance count",
                    "min": 1,
                    "max": 463,
                    "disabled": "!data.aircraftEnabled || !data.backgroundEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "backgroundIntervalS": {
                    "type": "number",
                    "label": "Background interval (seconds)",
                    "help": "How often the aircraft states are updated",
                    "min": 30,
                    "max": 600,
                    "disabled": "!data.aircraftEnabled || !data.backgroundEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "overheadElevation": {
                    "type": "number",
                    "label": "Overhead from (degrees above the horizon)",
                    "help": "An aircraft at least this high in the sky counts as overhead",
                    "min": 10,
                    "max": 90,
                    "disabled": "!data.aircraftEnabled || !data.backgroundEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "auroraTab": {
            "type": "panel",
            "label": "Aurora",
            "items": {
                "auroraEnabled": {
                    "type": "checkbox",
                    "label": "Aurora: can it be seen from home now?",
                    "help": "Uses the NOAA aurora forecast and Open-Meteo cloud cover, fetched only while it is getting dark or dark",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "auroraNowcastInstance": {
                    "type": "text",
                    "label": "aurora-nowcast instance for the Kp index",
                    "help": "For example aurora-nowcast.0. Leave empty if that adapter is not installed.",
                    "disabled": "!data.auroraEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "auroraCloudLimit": {
                    "type": "number",
                    "label": "Cloud cover limit (%)",
                    "help": "With more cloud than this the aurora counts as not visible",
                    "min": 0,
                    "max": 100,
                    "disabled": "!data.auroraEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "auroraWatchUk": {
                    "type": "checkbox",
                    "label": "Use AuroraWatch UK (UK only)",
                    "help": "UK-wide alert level from Lancaster University; amber or red counts as near enough",
                    "disabled": "!data.auroraEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "lightningTab": {
            "type": "panel",
            "label": "Lightning",
            "items": {
                "lightningEnabled": {
                    "type": "checkbox",
                    "label": "Lightning nearby",
                    "help": "Strikes from the Blitzortung community network (non-commercial use only)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "lightningRadiusKm": {
                    "type": "number",
                    "label": "Strike radius (km)",
                    "help": "Strikes within this distance are kept for an hour",
                    "min": 10,
                    "max": 1000,
                    "disabled": "!data.lightningEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "lightningNearKm": {
                    "type": "number",
                    "label": "Near radius (km)",
                    "help": "A strike this close after a quiet half hour raises the lightning alert",
                    "min": 1,
                    "max": 1000,
                    "disabled": "!data.lightningEnabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "notifyTab": {
            "type": "panel",
            "label": "Notifications",
            "items": {
                "notifyIntro": {
                    "type": "staticText",
                    "text": "Every alert is also a state, so you can build your own rules instead. Recipient: required for Discord (user ID, user name or serverID/channelID); optional e-mail address for email, user for Telegram, topic for ntfy.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifyTargets": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "8%",
                            "default": true
                        },
                        {
                            "type": "instance",
                            "attr": "instance",
                            "title": "Messaging instance",
                            "width": "20%",
                            "adapter": "",
                            "adapters": [
                                "pushover",
                                "telegram",
                                "email",
                                "signal-cmb",
                                "whatsapp-cmb",
                                "matrix-org",
                                "gotify",
                                "ntfy-client",
                                "pushsafer",
                                "pushbullet",
                                "discord",
                                "synochat"
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "recipient",
                            "title": "Recipient (optional)",
                            "width": "24%",
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "satellitePass",
                            "title": "Satellite pass",
                            "width": "12%",
                            "default": true
                        },
                        {
                            "type": "checkbox",
                            "attr": "aurora",
                            "title": "Aurora",
                            "width": "12%",
                            "default": true
                        },
                        {
                            "type": "checkbox",
                            "attr": "lightning",
                            "title": "Lightning",
                            "width": "12%",
                            "default": true
                        },
                        {
                            "type": "checkbox",
                            "attr": "aircraftEmergency",
                            "title": "Aircraft emergency",
                            "width": "12%",
                            "default": true
                        }
                    ]
                },
                "notifyAdmin": {
                    "type": "checkbox",
                    "label": "Also show in the ioBroker notifications (Admin and notification-manager)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifyRulesText": {
                    "type": "staticText",
                    "text": "Per event: at most one message in the cooldown time, and none in the quiet hours (ioBroker host time, from the first hour until the second; the same hour twice means no quiet time).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifySatellitePassHeader": {
                    "type": "header",
                    "text": "Satellite pass",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifySatellitePassCooldown": {
                    "type": "number",
                    "label": "Cooldown (minutes)",
                    "min": 0,
                    "max": 1440,
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifySatellitePassQuietFrom": {
                    "type": "number",
                    "label": "Quiet from (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifySatellitePassQuietTo": {
                    "type": "number",
                    "label": "Quiet until (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAuroraHeader": {
                    "type": "header",
                    "text": "Aurora",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifyAuroraCooldown": {
                    "type": "number",
                    "label": "Cooldown (minutes)",
                    "min": 0,
                    "max": 1440,
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAuroraQuietFrom": {
                    "type": "number",
                    "label": "Quiet from (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAuroraQuietTo": {
                    "type": "number",
                    "label": "Quiet until (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyLightningHeader": {
                    "type": "header",
                    "text": "Lightning",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifyLightningCooldown": {
                    "type": "number",
                    "label": "Cooldown (minutes)",
                    "min": 0,
                    "max": 1440,
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyLightningQuietFrom": {
                    "type": "number",
                    "label": "Quiet from (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyLightningQuietTo": {
                    "type": "number",
                    "label": "Quiet until (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAircraftEmergencyHeader": {
                    "type": "header",
                    "text": "Aircraft emergency",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "notifyAircraftEmergencyCooldown": {
                    "type": "number",
                    "label": "Cooldown (minutes)",
                    "min": 0,
                    "max": 1440,
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAircraftEmergencyQuietFrom": {
                    "type": "number",
                    "label": "Quiet from (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                },
                "notifyAircraftEmergencyQuietTo": {
                    "type": "number",
                    "label": "Quiet until (hour)",
                    "min": 0,
                    "max": 23,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 2,
                    "xl": 2
                }
            }
        }
    }
}
